# ============ Build output ============
# Anything a compiler produces. Never commit it.
build/
bin/
obj/
*.o
*.d
*.a
*.so
*.elf
*.bin
*.hex
*.map
*.su
*.lst

# ============ LNC / STM32CubeIDE ============
# Build output and local IDE preferences only.
LNC/Debug/
LNC/Release/
LNC/.settings/

# Keep these — do NOT ignore:
#   LNC/.project  .cproject  .mxproject  *.ioc  Core/  Drivers/
# Without them nobody can open or build the firmware from a clone.
# The .ioc holds the pin and clock config. Losing it means redoing
# the whole CubeMX setup by hand.

# ============ Runtime output ============
# Files your own programs write at run time. Data, not source.
logs/
data/
*.log
events.txt
*.db

# ============ Editors / IDEs ============
.vscode/
.idea/
*.swp
*.swo
*~
compile_commands.json
.cache/

# ============ Windows / macOS junk ============
Thumbs.db
desktop.ini
.DS_Store

# ============ Debug / coverage artifacts ============
# Core dumps are named core.<pid>. The bare word "core" is NOT safe here:
# this repo lives on an NTFS drive, so Git matches case-insensitively and
# "core" would swallow LNC/Core/ and everything inside it.
core.[0-9]*
vgcore.*
*.gcda
*.gcno
